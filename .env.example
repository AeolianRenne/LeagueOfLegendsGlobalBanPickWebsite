BANPICK_DATA_DIR=/data
BANPICK_ADMIN_INITIAL_PASSWORD=change-this-before-production
BANPICK_BOT_API_KEY=change-this-in-production
BANPICK_PUBLIC_BASE_URL=http://localhost:8000
BANPICK_MAX_ACTIVE_MATCHES=1
BANPICK_BAN_SECONDS=30
BANPICK_PICK_SECONDS=30
BANPICK_CHAMPION_REFRESH_INTERVAL_SECONDS=0
BANPICK_COOKIE_SECURE=false
# Optional Docker registry proxy for servers that cannot reach Docker Hub.
# BANPICK_NODE_BASE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
# BANPICK_PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
